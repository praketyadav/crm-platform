# ==============================================
# CRM Platform — Environment Variables
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ==============================================

# Database (MySQL — local install or Docker)
# Local:  mysql://crm_user:crm_password_2024@localhost:3306/crm_db
# Docker: mysql://crm_user:crm_password_2024@localhost:3306/crm_db
DATABASE_URL="mysql://crm_user:crm_password_2024@localhost:3306/crm_db"

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="change-me-to-a-256-bit-secret"
JWT_REFRESH_SECRET="change-me-to-another-256-bit-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# NVIDIA AI — Nemotron (via OpenAI-compatible API at integrate.api.nvidia.com)
NVIDIA_API_KEY="nvapi-..."

# Email (Gmail SMTP with App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="yourteam@gmail.com"
SMTP_PASS="gmail-app-password"
FROM_EMAIL="CRM Platform <yourteam@gmail.com>"

# App Config
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"
